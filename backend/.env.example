# Copia este archivo como .env y completa los valores.
# En Render las variables se configuran desde el panel del servicio.

# Puerto del servidor (Render lo inyecta automáticamente).
PORT=4000

# Cadena de conexión de PostgreSQL.
# Local: postgres://usuario:password@localhost:5432/recetario
# Render: la cadena "External Database URL" del recurso de base de datos.
DATABASE_URL=postgres://usuario:password@localhost:5432/recetario

# Secreto para firmar los tokens JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
